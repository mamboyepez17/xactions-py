# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# Loaded automatically since v1.3.0 (no need to export).

# Get auth_token and ct0 from:
# x.com → DevTools (F12) → Application → Cookies → x.com
TWITTER_COOKIES="auth_token=YOUR_AUTH_TOKEN; ct0=YOUR_CT0"
# Optional: add twid (e.g. "; twid=u%3D123456") so `validate` reports your own
# user id and handle without an extra lookup.

# Multi-account (optional): separate cookie strings with |||
# TWITTER_COOKIES="auth_token=C1; ct0=X1|||auth_token=C2; ct0=X2"

# Optional proxy (http://host:port or socks5://host:port)
# TWITTER_PROXY=

# Tracking SQLite database path (optional)
# XACTIONS_DB=~/.xactions/xactions.db
