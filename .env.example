# Copia este archivo como .env y rellena tus valores
# NUNCA subas .env a GitHub
# Se carga automáticamente desde v1.3.0 (no hace falta export)

# Obtén auth_token y ct0 de:
# x.com → DevTools (F12) → Application → Cookies → x.com
TWITTER_COOKIES="auth_token=TU_AUTH_TOKEN_AQUI; ct0=TU_CT0_AQUI"

# Multi-cuenta (opcional): separa varias cookies con |||
# TWITTER_COOKIES="auth_token=C1; ct0=X1|||auth_token=C2; ct0=X2"

# Proxy opcional (http://host:port o socks5://host:port)
# TWITTER_PROXY=

# Path de la base SQLite de tracking (opcional)
# XACTIONS_DB=~/.xactions/xactions.db
